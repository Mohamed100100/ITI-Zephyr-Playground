/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Black Pill F401CC overlay for the Digital_To_Volt demo.
 *
 * Exposes ADC1 channel 1 (pin PA1) to the app via /zephyr,user io-channels,
 * the same pattern used by zephyr/samples/drivers/adc/adc_dt.
 * The app reads it with ADC_DT_SPEC_GET / adc_read_dt().
 */

/ {
	zephyr,user {
		io-channels = <&adc1 1>;
	};
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};
